<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-owned per ADR-0005. miniquad does NOT use NativeActivity or GameActivity,
  so this declares a plain Activity that loads the cdylib and calls into it
  through miniquad's QuadNative JNI class.

  glEsVersion is declared explicitly as 3.0. miniquad's own default is 2.0, and
  its real floor is GLES 2.0, so ES3 features unlock only when the runtime
  GL_VERSION string reports ES 3. Do not write `#version 300 es` shaders.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kingtongue.two">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="King Tongue 2"
        android:hasCode="true"
        android:allowBackup="false">

        <activity
            android:name="quad_native.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
